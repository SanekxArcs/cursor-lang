<ui:FluentWindow x:Class="LanguageCursor.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:LanguageCursor.Views"
                 xmlns:vm="clr-namespace:LanguageCursor.ViewModels"
                 Title="Language Cursor" Width="940" Height="820" MinWidth="680" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="Language Cursor" ShowHelp="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="1000" Margin="36,4,36,36">

        <!-- Active language -->
        <Border Style="{StaticResource SettingsPanel}" Padding="20" Margin="0,8,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="76" Height="76" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
              <views:BadgeView Text="{Binding CurrentLabel}" BadgeColor="{Binding CurrentColor}" ImagePath="{Binding CurrentImagePath}"
                               BadgeFontSize="20" Roundness="{Binding Roundness}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
              <TextBlock Text="Active input language" Style="{StaticResource CardDescription}" Margin="0" />
              <TextBlock Text="{Binding CurrentLanguageDisplay}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,2,0,2" />
              <TextBlock Text="{Binding CurrentLanguageDescription}" Style="{StaticResource CardDescription}" Margin="0" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
              <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" OnContent="On" OffContent="Paused" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource CardDescription}" Margin="0,6,0,0" MaxWidth="220" TextAlignment="Right" />
            </StackPanel>
          </Grid>
        </Border>

        <ui:InfoBar Title="Something needs attention" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="True"
                    IsOpen="{Binding HasError, Mode=TwoWay}" Margin="0,8,0,0" />

        <!-- Indicator -->
        <TextBlock Text="Indicator" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,4">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="Indicator style" Style="{StaticResource CardTitle}" />
              <TextBlock Text="The label next to the pointer leaves Windows cursors untouched." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ComboBox Width="260" ItemsSource="{x:Static vm:MainViewModel.ModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding Mode, Mode=TwoWay}" />
        </ui:CardControl>

        <!-- Follow-pointer settings -->
        <StackPanel Visibility="{Binding IsFollowPointerMode, Converter={StaticResource BoolToVisibility}}">
          <Border Style="{StaticResource SettingsPanel}" Padding="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Margin="16" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" MinHeight="250">
                <Grid>
                  <views:BadgePreview Text="{Binding CurrentLabel}" BadgeColor="{Binding CurrentColor}" ImagePath="{Binding CurrentImagePath}"
                                      BadgeFontSize="{Binding BadgeSize}" Roundness="{Binding Roundness}" Shadow="{Binding Shadow}"
                                      Position="{Binding Position}" OffsetX="{Binding OffsetX}" OffsetY="{Binding OffsetY}"
                                      BadgeOpacity="{Binding BadgeOpacity}" UseTextPointer="{Binding PreviewOverText}" />
                  <TextBlock Text="Preview" Style="{StaticResource CardDescription}" Margin="10,8" VerticalAlignment="Top" HorizontalAlignment="Left" />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Margin="4,16,20,16">
                <TextBlock Text="Position and look" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                <TextBlock Text="Changes apply right away. Move your pointer to see the real label." Style="{StaticResource CardDescription}" />

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <UniformGrid Rows="3" Columns="3" Width="126" Height="126" VerticalAlignment="Top">
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Above left" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=TopLeft}"><ui:SymbolIcon Symbol="ArrowUpLeft24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Above" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Top}"><ui:SymbolIcon Symbol="ArrowUp24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Above right" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=TopRight}"><ui:SymbolIcon Symbol="ArrowUpRight24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Left" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Left}"><ui:SymbolIcon Symbol="ArrowLeft24" /></RadioButton>
                    <Border Margin="2" CornerRadius="6"><ui:SymbolIcon Symbol="Cursor24" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /></Border>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Right" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Right}"><ui:SymbolIcon Symbol="ArrowRight24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Below left" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=BottomLeft}"><ui:SymbolIcon Symbol="ArrowDownLeft24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Below" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=Bottom}"><ui:SymbolIcon Symbol="ArrowDown24" /></RadioButton>
                    <RadioButton Style="{StaticResource PositionCell}" ToolTip="Below right" IsChecked="{Binding Position, Converter={StaticResource EnumEquals}, ConverterParameter=BottomRight}"><ui:SymbolIcon Symbol="ArrowUpLeft24" RenderTransformOrigin="0.5,0.5"><ui:SymbolIcon.RenderTransform><RotateTransform Angle="180" /></ui:SymbolIcon.RenderTransform></ui:SymbolIcon></RadioButton>
                  </UniformGrid>
                  <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Position" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="Where the label sits relative to the pointer tip. Near screen edges it flips to stay visible."
                               Style="{StaticResource CardDescription}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="44" />
                  </Grid.RowDefinitions>

                  <TextBlock Text="Horizontal distance" Style="{StaticResource FieldLabel}" IsEnabled="{Binding UsesHorizontalOffset}" />
                  <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="-40" Maximum="120" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                          IsEnabled="{Binding UsesHorizontalOffset}" Value="{Binding OffsetX, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" Text="{Binding OffsetX, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}" />

                  <TextBlock Grid.Row="1" Text="Vertical distance" Style="{StaticResource FieldLabel}" />
                  <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="-40" Maximum="120" SmallChange="1" LargeChange="5" IsMoveToPointEnabled="True"
                          IsEnabled="{Binding UsesVerticalOffset}" Value="{Binding OffsetY, Mode=TwoWay}" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OffsetY, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}" />

                  <TextBlock Grid.Row="2" Text="Size" Style="{StaticResource FieldLabel}" />
                  <Slider Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Minimum="8" Maximum="40" SmallChange="1" LargeChange="2" IsMoveToPointEnabled="True"
                          Value="{Binding BadgeSize, Mode=TwoWay}" />
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BadgeSize, StringFormat={}{0:0} px}" Style="{StaticResource ValueText}" />

                  <TextBlock Grid.Row="3" Text="Corner roundness" Style="{StaticResource FieldLabel}" />
                  <Slider Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                          Value="{Binding Roundness, Mode=TwoWay}" />
                  <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Roundness, StringFormat={}{0:P0}}" Style="{StaticResource ValueText}" />

                  <TextBlock Grid.Row="4" Text="Opacity" Style="{StaticResource FieldLabel}" />
                  <Slider Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" IsMoveToPointEnabled="True"
                          Value="{Binding BadgeOpacity, Mode=TwoWay}" />
                  <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BadgeOpacity, StringFormat={}{0:P0}}" Style="{StaticResource ValueText}" />

                  <TextBlock Grid.Row="5" Text="Drop shadow" Style="{StaticResource FieldLabel}" />
                  <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" LastChildFill="False">
                    <ui:ToggleSwitch DockPanel.Dock="Left" VerticalAlignment="Center" IsChecked="{Binding Shadow, Mode=TwoWay}" />
                    <ui:Button DockPanel.Dock="Right" Content="Reset to defaults" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Secondary"
                               Command="{Binding ResetAppearanceCommand}" VerticalAlignment="Center" />
                  </DockPanel>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <ui:CardControl Icon="{ui:SymbolIcon Eye24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="Show the label" Style="{StaticResource CardTitle}" />
                <TextBlock Text="&quot;Only over text fields&quot; shows it when the pointer becomes the text-select cursor." Style="{StaticResource CardDescription}" />
              </StackPanel>
            </ui:CardControl.Header>
            <ComboBox Width="260" ItemsSource="{x:Static vm:MainViewModel.VisibilityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding Visibility, Mode=TwoWay}" />
          </ui:CardControl>

          <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,4" Visibility="{Binding IsAfterSwitchVisibility, Converter={StaticResource BoolToVisibility}}">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="Display time" Style="{StaticResource CardTitle}" />
                <TextBlock Text="How long the label stays after the language changes, then fades out." Style="{StaticResource CardDescription}" />
              </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
              <Slider Width="200" VerticalAlignment="Center" Minimum="0.5" Maximum="5" SmallChange="0.25" LargeChange="0.5" IsMoveToPointEnabled="True"
                      Value="{Binding AfterSwitchSeconds, Mode=TwoWay}" />
              <TextBlock Width="56" Text="{Binding AfterSwitchSeconds, StringFormat={}{0:0.##} s}" Style="{StaticResource ValueText}" />
            </StackPanel>
          </ui:CardControl>

          <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="Hide while the pointer is hidden" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Some apps hide the pointer while you type or watch video." Style="{StaticResource CardDescription}" />
              </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding HideWhenPointerHidden, Mode=TwoWay}" />
          </ui:CardControl>

          <ui:CardControl Icon="{ui:SymbolIcon FullScreenMaximize24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
              <StackPanel>
                <TextBlock Text="Hide in full-screen apps" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Games, videos and presentations." Style="{StaticResource CardDescription}" />
              </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding HideInFullScreen, Mode=TwoWay}" />
          </ui:CardControl>
        </StackPanel>

        <!-- Text-cursor settings -->
        <ui:CardControl Icon="{ui:SymbolIcon TextT24}" Margin="0,0,0,4" Visibility="{Binding IsTextCursorMode, Converter={StaticResource BoolToVisibility}}">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="Label size in the text cursor" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Replaces the Windows text-select cursor while the app runs. It is restored when you pause or exit." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <StackPanel Orientation="Horizontal">
            <Slider Width="200" VerticalAlignment="Center" Minimum="1" Maximum="3" SmallChange="0.25" LargeChange="0.5" IsMoveToPointEnabled="True"
                    Value="{Binding TextCursorScale, Mode=TwoWay}" />
            <TextBlock Width="56" Text="{Binding TextCursorScale, StringFormat={}{0:0.##}×}" Style="{StaticResource ValueText}" />
          </StackPanel>
        </ui:CardControl>

        <!-- Languages -->
        <DockPanel Margin="2,28,0,8" LastChildFill="False">
          <TextBlock Text="Languages" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" DockPanel.Dock="Left" />
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Transparent" Command="{Binding RefreshLanguagesCommand}" DockPanel.Dock="Right"
                     ToolTip="Re-read keyboard layouts after changing them in Windows Settings" />
        </DockPanel>

        <TextBlock Text="No keyboard layouts were found. Add one in Windows Settings › Time &amp; language, then select Refresh."
                   Style="{StaticResource CardDescription}" Margin="2,0,0,8">
          <TextBlock.Visibility>
            <Binding Path="Languages.Count">
              <Binding.Converter>
                <views:ZeroToVisibleConverter />
              </Binding.Converter>
            </Binding>
          </TextBlock.Visibility>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Languages}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:LanguageItemViewModel}">
              <ui:CardExpander Margin="0,0,0,4" ContentPadding="0">
                <ui:CardExpander.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:BadgeView Text="{Binding EffectiveLabel}" BadgeColor="{Binding Color}" ImagePath="{Binding ImagePath}" BadgeFontSize="12"
                                     Roundness="{Binding DataContext.Roundness, RelativeSource={RelativeSource AncestorType=Window}}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Border Grid.Column="2" Margin="12,0,8,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="Active" FontSize="12" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                  </Grid>
                </ui:CardExpander.Header>

                <StackPanel>
                  <!-- Label -->
                  <Grid Margin="56,14,16,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Label text" Style="{StaticResource CardTitle}" />
                      <TextBlock Style="{StaticResource CardDescription}">
                        <Run Text="Up to 6 characters. Leave empty to use" /> <Run Text="{Binding DefaultLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:TextBox Width="150" MaxLength="6" PlaceholderText="{Binding DefaultLabel}" ClearButtonEnabled="False"
                                  Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}" />
                      <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Transparent" ToolTip="Use the language code"
                                 IsEnabled="{Binding HasCustomLabel}" Command="{Binding DataContext.ResetLabelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                  <Separator Margin="0" />

                  <!-- Colour -->
                  <Grid Margin="56,14,16,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top" Margin="0,4,16,0">
                      <TextBlock Text="Colour" Style="{StaticResource CardTitle}" />
                      <TextBlock Text="Text colour adjusts automatically for contrast." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <ListBox Style="{StaticResource SwatchList}" Width="204" SelectedItem="{Binding ColorHex, Mode=TwoWay}" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <ui:TextBox Width="120" MaxLength="7" PlaceholderText="#RRGGBB" ClearButtonEnabled="False"
                                    Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Appearance="Transparent" ToolTip="Automatic colour"
                                   IsEnabled="{Binding HasCustomColor}" Command="{Binding DataContext.ResetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <Separator Margin="0" />

                  <!-- Image -->
                  <Grid Margin="56,14,16,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Image instead of text" Style="{StaticResource CardTitle}" />
                      <TextBlock Text="{Binding ImageFileName}" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="Choose image" Icon="{ui:SymbolIcon ImageAdd24}"
                                 Command="{Binding DataContext.ChooseTypingImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="Remove image" IsEnabled="{Binding HasImage}"
                                 Command="{Binding DataContext.RemoveTypingImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                  <Separator Margin="0" />

                  <!-- Pointer -->
                  <Grid Margin="56,14,16,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Custom pointer (optional)" Style="{StaticResource CardTitle}" />
                      <TextBlock Text="{Binding CursorFileName}" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <ui:Button Content="Choose .cur / .ani" Icon="{ui:SymbolIcon Cursor24}"
                                 Command="{Binding DataContext.ChooseCursorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="Use the Windows pointer" IsEnabled="{Binding HasCursor}"
                                 Command="{Binding DataContext.RemoveCursorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </ui:CardExpander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- General -->
        <TextBlock Text="General" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Margin="0,0,0,4">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="App theme" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Choose Light, Dark or follow Windows." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ComboBox Width="260" ItemsSource="{x:Static vm:MainViewModel.ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                    SelectedValue="{Binding Theme, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Starts quietly in the notification area when you sign in." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,0,4">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="Restore Windows cursors" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Pauses Language Cursor and reloads your Windows pointer scheme." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ui:Button Content="Restore" Command="{Binding RestoreCursorCommand}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,4">
          <ui:CardControl.Header>
            <StackPanel>
              <TextBlock Text="Settings and logs" Style="{StaticResource CardTitle}" />
              <TextBlock Text="Stored in %LocalAppData%\LanguageCursor." Style="{StaticResource CardDescription}" />
            </StackPanel>
          </ui:CardControl.Header>
          <ui:Button Content="Open folder" Command="{Binding OpenDataFolderCommand}" />
        </ui:CardControl>

        <TextBlock Margin="2,20,0,0" Style="{StaticResource CardDescription}">
          <Run Text="Language Cursor" FontWeight="SemiBold" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
          <Run Text="· Closing this window keeps the app running in the notification area." />
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</ui:FluentWindow>
