  <assemblyIdentity version="2.0.0.0" name="LanguageCursor.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3"><security><requestedPrivileges><requestedExecutionLevel level="asInvoker" uiAccess="false" /></requestedPrivileges></security></trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility"><application><supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" /><supportedOS Id="{4f476546-937c-67b2-23e7-bf4f3b9c30a9}" /></application></compatibility>
